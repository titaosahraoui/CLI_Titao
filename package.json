{
  "name": "titao",
  "version": "0.1.0",
  "description": "Titao — Open-source CLI coding agent for local models via Ollama",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "titao": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "build:binary": "bun build src/index.ts --compile --outfile titao",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.0",
    "commander": "^12.0.0",
    "conf": "^13.0.0",
    "diff": "^7.0.0",
    "glob": "^11.0.0",
    "ignore": "^6.0.0",
    "ink": "^5.0.0",
    "marked": "^14.0.0",
    "marked-terminal": "^7.0.0",
    "openai": "^4.70.0",
    "ora": "^8.0.0",
    "react": "^18.3.0",
    "simple-git": "^3.27.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
